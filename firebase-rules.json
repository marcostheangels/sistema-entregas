{
  "rules": {
    "empresas": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admin').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || root.child('admin').child(auth.uid).val() === true)"
      }
    },
    "entregadores": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admin').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || root.child('admin').child(auth.uid).val() === true)",
        "empresasBloqueadas": {
          "$empresaId": {
            ".write": "auth != null && auth.uid === $empresaId"
          }
        },
        "lastHeartbeat": {
          ".write": true,
          ".validate": "newData.isNumber()"
        }
      }
    },
    "entregas": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admin').child(auth.uid).val() === true",
      ".indexOn": ["empresaId", "status", "entregadorId"],
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('empresaId').val() === auth.uid && root.child('empresas').child(auth.uid).exists() && root.child('aprovacoes').child(auth.uid).child('aprovado').val() === true) || (data.exists() && data.child('empresaId').val() === auth.uid) || (data.exists() && data.child('entregadorId').val() === auth.uid) || (data.exists() && data.child('status').val() === 'pendente' && newData.child('entregadorId').val() === auth.uid))"
      }
    },
    "posicoes": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admin').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null",
        ".write": true,
        "lat": { ".validate": "newData.isNumber()" },
        "lng": { ".validate": "newData.isNumber()" },
        "timestamp": { ".validate": "newData.isNumber()" },
        "online": { ".validate": "newData.isBoolean()" },
        "source": { ".validate": true },
        "$other": { ".validate": false }
      }
    },
    "mensagens": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admin').child(auth.uid).val() === true",
      ".indexOn": ["entregadorId", "empresaId", "entregaId"],
      "$id": {
        ".write": "auth != null && ((!newData.exists() && data.exists() && (data.child('empresaId').val() === auth.uid || data.child('entregadorId').val() === auth.uid) && (!root.child('entregas').child(data.child('entregaId').val()).exists() || root.child('entregas').child(data.child('entregaId').val()).child('status').val() === 'entregue')) || (((newData.child('de').val() === 'empresa' && newData.child('empresaId').val() === auth.uid) || (newData.child('de').val() === 'entregador' && newData.child('entregadorId').val() === auth.uid)) && root.child('entregas').child(newData.child('entregaId').val()).child('empresaId').val() === newData.child('empresaId').val() && root.child('entregas').child(newData.child('entregaId').val()).child('entregadorId').val() === newData.child('entregadorId').val() && (root.child('entregas').child(newData.child('entregaId').val()).child('status').val() === 'aceite' || root.child('entregas').child(newData.child('entregaId').val()).child('status').val() === 'em_transito') && root.child('posicoes').child(newData.child('entregadorId').val()).child('online').val() === true))",
        "empresaId": { ".validate": "newData.isString()" },
        "entregadorId": { ".validate": "newData.isString()" },
        "entregaId": { ".validate": "newData.isString()" },
        "texto": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
        "de": { ".validate": "newData.val() === 'empresa' || newData.val() === 'entregador'" },
        "empresaNome": { ".validate": true },
        "timestamp": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "admin": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admin').child(auth.uid).val() === true || auth.token.email === 'marcostheangels@gmail.com')",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !data.exists() && !root.child('admin').hasChildren() && newData.val() === true"
      }
    },
    "aprovacoes": {
      ".read": "root.child('admin').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('admin').child(auth.uid).val() === true || (!data.exists() && newData.child('criadoPor').val() === auth.uid))",
        "tipo": { ".validate": "newData.val() === 'empresa' || newData.val() === 'entregador'" },
        "nome": { ".validate": "newData.isString()" },
        "email": { ".validate": "newData.isString()" },
        "telefone": { ".validate": true },
        "cpf": { ".validate": true },
        "veiculo": { ".validate": true },
        "placa": { ".validate": true },
        "endereco": { ".validate": true },
        "aprovado": { ".validate": "newData.val() === false || root.child('admin').child(auth.uid).val() === true" },
        "criadoPor": { ".validate": "newData.val() === auth.uid || root.child('admin').child(auth.uid).val() === true" },
        "criadoEm": { ".validate": "newData.isNumber()" },
        "aprovadoEm": { ".validate": true },
        "$other": { ".validate": false }
      }
    }
  }
}
