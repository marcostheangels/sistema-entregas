{
  "rules": {
    "empresas": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "entregadores": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "empresasBloqueadas": {
          "$empresaId": {
            ".write": "auth != null && auth.uid === $empresaId"
          }
        },
        "lastHeartbeat": {
          ".write": true,
          ".validate": "newData.isNumber()"
        }
      }
    },
    "entregas": {
      ".read": "auth != null",
      ".indexOn": ["empresaId", "status", "entregadorId"],
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('empresaId').val() === auth.uid && root.child('empresas').child(auth.uid).exists()) || (data.exists() && data.child('empresaId').val() === auth.uid) || (data.exists() && data.child('entregadorId').val() === auth.uid) || (data.exists() && data.child('status').val() === 'pendente' && newData.child('entregadorId').val() === auth.uid))"
      }
    },
    "posicoes": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": true,
        "lat": { ".validate": "newData.isNumber()" },
        "lng": { ".validate": "newData.isNumber()" },
        "timestamp": { ".validate": "newData.isNumber()" },
        "online": { ".validate": "newData.isBoolean()" },
        "source": { ".validate": true },
        "$other": { ".validate": false }
      }
    },
    "mensagens": {
      ".read": "auth != null",
      ".indexOn": ["entregadorId", "empresaId"],
      "$id": {
        ".write": "auth != null && (newData.child('empresaId').val() === auth.uid || newData.child('entregadorId').val() === auth.uid)",
        "empresaId": { ".validate": "newData.isString()" },
        "entregadorId": { ".validate": "newData.isString()" },
        "texto": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
        "de": { ".validate": "newData.val() === 'empresa' || newData.val() === 'entregador'" },
        "empresaNome": { ".validate": true },
        "timestamp": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
